{
  "AccessoryToggler": {
    "modName": "AccessoryToggler",
    "version": "2.4.0",
    "schema": {
      "Enabled": {
        "type": "boolean",
        "description": "Enable or disable Accessory Toggler globally.",
        "default": true
      },
      "Language": {
        "type": "enum",
        "description": "Language code for the UI labels (e.g. system, en, es, ja, zh-Hans, zh-Hant). 'system' will detect the game language.",
        "default": "system",
        "options": [
          "system",
          "en",
          "es",
          "ja",
          "zh-Hans",
          "zh-Hant",
          "fr",
          "it",
          "de",
          "ko",
          "pt-BR",
          "ru",
          "th",
          "vi",
          "id",
          "tr",
          "pl",
          "es-MX"
        ]
      },
      "SlotsToShow": {
        "type": "number",
        "description": "Number of accessory slots to display on the HUD (1 to 4).",
        "default": 4,
        "min": 1,
        "max": 4,
        "step": 1
      },
      "HUDX": {
        "type": "number",
        "description": "Manual horizontal coordinate of the display HUD widget as a percentage of screen width (0 to 100). Leave null for auto/drag-and-drop position.",
        "default": null,
        "min": 0,
        "max": 100,
        "step": 0.1
      },
      "HUDY": {
        "type": "number",
        "description": "Manual vertical coordinate of the display HUD widget as a percentage of screen height (0 to 100). Leave null for auto/drag-and-drop position.",
        "default": null,
        "min": 0,
        "max": 100,
        "step": 0.1
      },
      "HUDScale": {
        "type": "number",
        "description": "Scale factor for the accessory HUD display size.",
        "default": 1.5,
        "min": 0.5,
        "max": 3.0,
        "step": 0.1
      },
      "ScanIntervalMs": {
        "type": "number",
        "description": "Interval between checking player accessories (ms).",
        "default": 1000,
        "min": 100,
        "max": 5000,
        "step": 100
      },
      "Debug": {
        "type": "boolean",
        "description": "Toggle debug diagnostic prints to the UE4SS log console.",
        "default": false
      },
      "CardBg": {
        "type": "color",
        "description": "RGBA color of the HUD widget background panel.",
        "default": {
          "R": 0.05,
          "G": 0.07,
          "B": 0.15,
          "A": 0.85
        }
      },
      "BorderColor": {
        "type": "color",
        "description": "RGBA color of the HUD widget border line.",
        "default": {
          "R": 0.0,
          "G": 0.95,
          "B": 1.0,
          "A": 0.6
        }
      },
      "ShadowColor": {
        "type": "color",
        "description": "RGBA color of the drop shadow effect.",
        "default": {
          "R": 0.0,
          "G": 0.0,
          "B": 0.0,
          "A": 0.9
        }
      },
      "TextColorEnabled": {
        "type": "color",
        "description": "RGBA color of active/enabled slot values.",
        "default": {
          "R": 0.0,
          "G": 0.96,
          "B": 0.83,
          "A": 1.0
        }
      },
      "TextColorDisabled": {
        "type": "color",
        "description": "RGBA color of empty/disabled slot values.",
        "default": {
          "R": 1.0,
          "G": 0.35,
          "B": 0.37,
          "A": 1.0
        }
      },
      "TextColorLabel": {
        "type": "color",
        "description": "RGBA color of category / title labels.",
        "default": {
          "R": 0.9,
          "G": 0.9,
          "B": 0.95,
          "A": 1.0
        }
      },
      "KeyBinds": {
        "type": "section",
        "description": "Keybindings for toggling accessory slots and editor mode.",
        "properties": {
          "Modifier": {
            "type": "enum",
            "description": "Modifier key required for utility shortcuts (ToggleEditMode, ResetCoords, ToggleUI).",
            "default": "ALT",
            "options": [
              "ALT",
              "CTRL",
              "SHIFT",
              "NONE"
            ]
          },
          "ToggleSlot1": {
            "type": "keybind",
            "description": "Hotkey to toggle Slot 1 accessory.",
            "default": "FIVE"
          },
          "ToggleSlot2": {
            "type": "keybind",
            "description": "Hotkey to toggle Slot 2 accessory.",
            "default": "SIX"
          },
          "ToggleSlot3": {
            "type": "keybind",
            "description": "Hotkey to toggle Slot 3 accessory.",
            "default": "SEVEN"
          },
          "ToggleSlot4": {
            "type": "keybind",
            "description": "Hotkey to toggle Slot 4 accessory.",
            "default": "EIGHT"
          },
          "ToggleEditMode": {
            "type": "keybind",
            "description": "Hotkey to toggle screen-drag UI editor mode (requires the configured Modifier).",
            "default": "F7"
          },
          "ResetCoords": {
            "type": "keybind",
            "description": "Hotkey to reset HUD coordinates back to default position in edit mode (requires the configured Modifier).",
            "default": "R"
          },
          "ToggleUI": {
            "type": "keybind",
            "description": "Hotkey to toggle HUD visibility (requires the configured Modifier).",
            "default": "H"
          }
        }
      }
    }
  },
  "HoldToFire": {
    "modName": "HoldToFire",
    "version": "1.0.0",
    "schema": {
      "Enabled": {
        "type": "boolean",
        "description": "Enable or disable Hold To Fire globally.",
        "default": true
      },
      "DebugMode": {
        "type": "boolean",
        "description": "Print debug messages to the UE4SS log console.",
        "default": true
      },
      "ScanIntervalMs": {
        "type": "number",
        "description": "Interval in milliseconds between equipped weapon changes checks.",
        "default": 2000,
        "min": 100,
        "max": 5000,
        "step": 100
      },
      "WeaponTypes": {
        "type": "section",
        "description": "Toggles autofire functionality per weapon type.",
        "properties": {
          "Handgun": {
            "type": "boolean",
            "description": "Autofire for Handguns.",
            "default": true
          },
          "SniperRifle": {
            "type": "boolean",
            "description": "Autofire for Sniper Rifles.",
            "default": true
          },
          "Shotgun": {
            "type": "boolean",
            "description": "Autofire for Shotguns.",
            "default": true
          },
          "RocketLauncher": {
            "type": "boolean",
            "description": "Autofire for Rocket Launchers.",
            "default": true
          },
          "BowGun": {
            "type": "boolean",
            "description": "Autofire for Bows/Crossbows.",
            "default": true
          },
          "LaserRifle": {
            "type": "boolean",
            "description": "Autofire for Laser Rifles.",
            "default": true
          },
          "MissileLauncher": {
            "type": "boolean",
            "description": "Autofire for Missile Launchers.",
            "default": true
          },
          "GrenadeLauncher": {
            "type": "boolean",
            "description": "Autofire for Grenade Launchers.",
            "default": true
          }
        }
      }
    }
  },
  "FreeCam": {
    "modName": "FreeCam",
    "version": "1.0.1",
    "schema": {
      "Debug": {
        "type": "boolean",
        "description": "Configuration for Debug.",
        "default": false
      },
      "DefaultSpeed": {
        "type": "number",
        "description": "Default camera flight speed.",
        "default": 15.0,
        "min": 2.0,
        "max": 150.0,
        "step": 1.0
      },
      "BaseOnly": {
        "type": "boolean",
        "description": "Configuration for BaseOnly.",
        "default": true
      },
      "MaxRange": {
        "type": "number",
        "description": "Configuration for MaxRange.",
        "default": 50.0
      },
      "KeyBinds": {
        "type": "section",
        "description": "Keybindings for controlling the FreeCam mod.",
        "properties": {
          "ToggleFreeCam": {
            "type": "keybind",
            "description": "Hotkey to manually toggle FreeCam mode (requires the configured Modifier).",
            "default": "F8"
          },
          "Modifier": {
            "type": "enum",
            "description": "Modifier key required for the keyboard toggle shortcut.",
            "default": "ALT",
            "options": [
              "ALT",
              "CTRL",
              "SHIFT",
              "NONE"
            ]
          },
          "FlyUp": {
            "type": "keybind",
            "description": "Hotkey to fly upwards.",
            "default": "SpaceBar"
          },
          "FlyDown": {
            "type": "keybind",
            "description": "Hotkey to fly downwards.",
            "default": "LeftShift"
          },
          "SpeedUp": {
            "type": "keybind",
            "description": "Hotkey to increase camera flight speed.",
            "default": "PAGE_UP"
          },
          "SpeedDown": {
            "type": "keybind",
            "description": "Hotkey to decrease camera flight speed.",
            "default": "PAGE_DOWN"
          }
        }
      },
      "Gamepad": {
        "type": "section",
        "description": "Gamepad input and controller shortcut settings.",
        "properties": {
          "ModifierButton": {
            "type": "enum",
            "description": "Required modifier button on the controller (e.g. Left Trigger, Right Trigger, or None).",
            "default": "Gamepad_LeftTrigger",
            "options": [
              "Gamepad_LeftTrigger",
              "Gamepad_RightTrigger",
              "Gamepad_LeftShoulder",
              "Gamepad_RightShoulder",
              "None"
            ]
          },
          "ToggleButton": {
            "type": "enum",
            "description": "Gamepad action button to trigger FreeCam toggle.",
            "default": "Gamepad_Special_Right",
            "options": [
              "Gamepad_Special_Right",
              "Gamepad_Special_Left",
              "Gamepad_LeftThumbstick",
              "Gamepad_RightThumbstick",
              "Gamepad_FaceButton_Top",
              "Gamepad_FaceButton_Left"
            ]
          },
          "FlyUpButton": {
            "type": "enum",
            "description": "Gamepad button to fly upwards (R3 / RS click by default).",
            "default": "Gamepad_RightThumbstick",
            "options": [
              "Gamepad_RightThumbstick",
              "Gamepad_LeftThumbstick",
              "Gamepad_RightShoulder",
              "Gamepad_LeftShoulder",
              "Gamepad_FaceButton_Top",
              "None"
            ]
          },
          "FlyDownButton": {
            "type": "enum",
            "description": "Gamepad button to fly downwards (L3 / LS click by default).",
            "default": "Gamepad_LeftThumbstick",
            "options": [
              "Gamepad_LeftThumbstick",
              "Gamepad_RightThumbstick",
              "Gamepad_LeftShoulder",
              "Gamepad_RightShoulder",
              "Gamepad_FaceButton_Bottom",
              "None"
            ]
          }
        }
      }
    }
  },
  "PresetSwitch": {
    "modName": "PresetSwitch",
    "version": "1.0.3",
    "schema": {
      "Enabled": {
        "type": "boolean",
        "description": "Enable or disable PresetSwitch mod.",
        "default": true
      },
      "Debug": {
        "type": "boolean",
        "description": "Enable diagnostic logging console prints.",
        "default": false
      },
      "KeyBinds": {
        "type": "section",
        "description": "Keybindings for switching native in-game Pal presets.",
        "properties": {
          "Modifier": {
            "type": "enum",
            "description": "Global modifier key for preset shortcuts (ALT, CTRL, SHIFT, or NONE).",
            "default": "ALT",
            "options": [
              "ALT",
              "CTRL",
              "SHIFT",
              "NONE"
            ]
          },
          "SwitchPreset1": {
            "type": "keybind",
            "description": "Hotkey to switch to Pal Preset 1.",
            "default": "FIVE"
          },
          "SwitchPreset2": {
            "type": "keybind",
            "description": "Hotkey to switch to Pal Preset 2.",
            "default": "SIX"
          },
          "SwitchPreset3": {
            "type": "keybind",
            "description": "Hotkey to switch to Pal Preset 3.",
            "default": "SEVEN"
          },
          "SwitchPreset4": {
            "type": "keybind",
            "description": "Hotkey to switch to Pal Preset 4.",
            "default": "EIGHT"
          },
          "SwitchPreset5": {
            "type": "keybind",
            "description": "Hotkey to switch to Pal Preset 5.",
            "default": "NINE"
          }
        }
      }
    }
  }
}